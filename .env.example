# device-mcp: variables for docker-compose.yml (on Coolify in the "Environment Variables" tab).
# Generate values: openssl rand -hex 32

# Public address of the server, without a trailing /. Appears in the install command and in the instructions in the panel.
PUBLIC_URL=https://mcp.example.com

# Token for the MCP endpoint /mcp (header: Authorization: Bearer <MCP_TOKEN>). At least 32 characters.
MCP_TOKEN=

# Password for the web panel. At least 12 characters.
PANEL_PASSWORD=

# Postgres in Compose. The password sits in a URL, so letters and digits only (openssl rand -hex 24).
POSTGRES_USER=devicemcp
POSTGRES_PASSWORD=
POSTGRES_DB=devicemcp

# Optional
# Lifetime of a panel session in hours, extended on every use.
SESSION_TTL_HOURS=168
# A new login is required at the latest this many days after logging in. A new PANEL_PASSWORD ends all sessions.
SESSION_MAX_DAYS=30
# The daemon reports in every N seconds. If it stays silent for longer than TIMEOUT, the device counts as offline.
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45
LOG_LEVEL=info
# How many proxy hops to trust for the client IP (X-Forwarded-For). Coolify/Traefik only: 1.
# Behind Cloudflare (proxy on) + Traefik: 2. Determines the IP for the login limit.
TRUST_PROXY=1

# Only for development without Docker (pnpm dev:server), Postgres from compose.local.yml:
# DATABASE_URL=postgres://devicemcp:<POSTGRES_PASSWORD>@localhost:5433/devicemcp

# Where devices download the daemon: the GitHub releases of the daemon repo. Only change this for a fork.
# DAEMON_RELEASE_URL=https://github.com/onem0/device-mcp-client/releases
