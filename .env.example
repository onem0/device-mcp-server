# device-mcp: Variablen für docker-compose.yml (auf Coolify im Reiter "Environment Variables").
# Werte erzeugen: openssl rand -hex 32

# Öffentliche Adresse des Servers, ohne / am Ende. Steht im Install-Befehl und in der Anleitung im Panel.
PUBLIC_URL=https://mcp.example.com

# Token für den MCP-Endpoint /mcp (Header: Authorization: Bearer <MCP_TOKEN>). Mindestens 32 Zeichen.
MCP_TOKEN=

# Passwort für das Web-Panel. Mindestens 12 Zeichen.
PANEL_PASSWORD=

# Postgres im Compose. Das Passwort steht in einer URL, also nur Buchstaben und Ziffern (openssl rand -hex 24).
POSTGRES_USER=devicemcp
POSTGRES_PASSWORD=
POSTGRES_DB=devicemcp

# Optional
# Gültigkeit einer Panel-Sitzung in Stunden, verlängert sich bei jeder Nutzung.
SESSION_TTL_HOURS=168
# Spätestens so viele Tage nach der Anmeldung ist neu anzumelden. Ein neues PANEL_PASSWORD beendet alle Sitzungen.
SESSION_MAX_DAYS=30
# Daemon meldet sich alle N Sekunden. Bleibt er länger als TIMEOUT stumm, gilt das Gerät als offline.
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_TIMEOUT_SECONDS=45
LOG_LEVEL=info
# Wie vielen Proxy-Hops die Client-IP (X-Forwarded-For) geglaubt wird. Nur Coolify/Traefik: 1.
# Hinter Cloudflare (Proxy an) + Traefik: 2. Bestimmt die IP für das Login-Limit.
TRUST_PROXY=1

# Nur für die Entwicklung ohne Docker (pnpm dev:server), Postgres aus compose.local.yml:
# DATABASE_URL=postgres://devicemcp:<POSTGRES_PASSWORD>@localhost:5433/devicemcp
